{
  "name": "@asterisk-labs/taco",
  "version": "0.14.2",
  "description": "JavaScript reader for the TACO format, independent of libtaco.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "types": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('types', { recursive: true, force: true })\" && tsc",
    "test": "node --input-type=module --check < ../docs/playground/app.js && node --input-type=module --check < ../docs/playground/rumi-preview.js && node --test test/*.test.js",
    "test:rumi": "node --test test/rumi.integration.js",
    "test:remote": "node --test test/remote.integration.js",
    "prepublishOnly": "npm run types && npm test"
  },
  "dependencies": {
    "hyparquet": "^1.25.0",
    "hyparquet-compressors": "^1.1.1"
  },
  "devDependencies": {
    "@asterisk-labs/rumi": "0.29.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "taco",
    "earth-observation",
    "geospatial",
    "parquet",
    "cloud-optimized",
    "range-requests"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asterisk-labs/taco.git",
    "directory": "javascript"
  },
  "homepage": "https://github.com/asterisk-labs/taco/tree/main/javascript#readme",
  "bugs": "https://github.com/asterisk-labs/taco/issues",
  "license": "MIT"
}
