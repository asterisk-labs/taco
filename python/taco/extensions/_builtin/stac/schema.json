  "properties": {
    "taco:extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "const": "https://asterisk.coop/taco/spec/extensions/stac/v1.0.0/schema.json"
          }
