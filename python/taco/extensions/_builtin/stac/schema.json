{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterisk.coop/taco/spec/extensions/stac/v1.0.0/schema.json",
  "title": "STAC",
  "description": "Temporal, spatial and STAC metadata profiles.",
  "type": "object",
  "required": [
    "taco:extensions",
    "taco:metadata"
